PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/crp_india
JWT_SECRET=your_jwt_secret_min_32_characters_long_for_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Cloudinary Persistent Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini AI Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Google OAuth (Citizen Authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud Vision (SafeSearch Image Content Safety)
# Feature toggle: false by default. Set to true to activate SafeSearch in production.
VISION_SAFETY_ENABLED=false

# Provide either key file path, credentials JSON string, or API key:
GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_CREDENTIALS_JSON=
# GOOGLE_CLOUD_VISION_API_KEY=

# SafeSearch Content Safety Thresholds (Optional: VERY_UNLIKELY, UNLIKELY, POSSIBLE, LIKELY, VERY_LIKELY, NONE)
# VISION_MAX_ADULT=LIKELY
# VISION_MAX_RACY=LIKELY
# VISION_MAX_VIOLENCE=VERY_LIKELY
# VISION_MAX_MEDICAL=NONE

# SafeSearch Monthly Hard Limit (Defaults to 999 checks per calendar month)
VISION_MONTHLY_LIMIT=999
